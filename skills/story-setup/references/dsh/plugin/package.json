{
  "name": "dsh-oh-story",
  "version": "0.1.0",
  "description": "DeepSeek Harness native host adapter for oh-story-claudecode: outline guard before prose, post-write prose checks, continuity context injection, and the story role roster.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.js" },
